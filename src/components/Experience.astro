---
import { experience, education, profile } from '../data/portfolio';
import { getLang, useTranslations, pick } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section id="experiencia" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-24">
  <div class="grid gap-16 lg:grid-cols-[3fr_2fr]">
    <!-- Experiencia: línea de tiempo -->
    <div>
      <h2 data-reveal class="font-display text-6xl uppercase">{t('exp.title')}</h2>
      <ol class="mt-10 border-l border-line">
        {experience.map((e, i) => (
          <li data-reveal style={`--d:${Math.min(i, 3) * 80}ms`} class="group relative pb-10 pl-8 last:pb-0">
            <span class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 rounded-full border-2 border-accent-fg bg-ink transition-colors duration-300 group-hover:bg-accent-fg"></span>
            <p class="text-xs font-bold tracking-widest text-accent-fg uppercase">{pick(e.period, lang)}</p>
            <h3 class="mt-1 text-lg font-bold">{pick(e.role, lang)}</h3>
            <p class="text-sm font-semibold text-muted">{e.org}</p>
            {pick(e.desc, lang) && <p class="mt-2 text-sm text-muted">{pick(e.desc, lang)}</p>}
          </li>
        ))}
      </ol>
    </div>

    <!-- Educación + idiomas -->
    <div>
      <h2 data-reveal class="font-display text-6xl uppercase">{t('exp.education')}</h2>
      <ul class="mt-10 space-y-4">
        {education.map((ed, i) => (
          <li data-reveal style={`--d:${i * 80}ms`} class="rounded-xl border border-line bg-surface p-6">
            <p class="text-xs font-bold tracking-widest text-accent-fg uppercase">{pick(ed.period, lang)}</p>
            <h3 class="mt-1 text-lg font-bold">{pick(ed.degree, lang)}</h3>
            <p class="text-sm text-muted">{ed.org}</p>
            {pick(ed.note, lang) && <p class="mt-3 inline-block rounded-full bg-accent px-3 py-1 text-xs font-bold text-on-accent">★ {pick(ed.note, lang)}</p>}
          </li>
        ))}
        <li data-reveal style="--d:160ms" class="rounded-xl border border-line bg-surface p-6">
          <p class="text-xs font-bold tracking-widest text-accent-fg uppercase">{t('exp.languages')}</p>
          <ul class="mt-4 space-y-5">
            {profile.languages.map((l) => (
              <li>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="text-lg font-bold">{pick(l.name, lang)}</h3>
                  <span class="text-sm font-semibold text-muted">{pick(l.level, lang)}</span>
                </div>
                <div class="mt-2 grid grid-cols-5 gap-1.5" role="img" aria-label={`${pick(l.level, lang)} (${l.score}/5)`}>
                  {Array.from({ length: 5 }, (_, s) => (
                    <span class={`h-1.5 rounded-full ${s < l.score ? 'bg-accent' : 'bg-line'}`}></span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </div>
  </div>
</section>
