---
import { profile } from '../data/portfolio';
const items = profile.socials.filter((s) => s.href); // las que no tienen URL no se muestran
---
{items.map((s) => (
  <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}
     class="grid h-12 w-12 place-items-center rounded-full bg-surface text-accent-fg transition-[transform,background-color] duration-150 hover:-translate-y-0.5 hover:bg-surface-2">
    <span class="icon-mask h-5 w-5" style={`--icon:url(${s.icon})`}></span>
  </a>
))}
