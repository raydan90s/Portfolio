---
import { achievements } from '../data/portfolio';
import { getLang, useTranslations, pick } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section id="logros" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-24">
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div data-reveal class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="font-display text-6xl leading-[0.9] uppercase">{t('ach.title1')}<br />{t('ach.title2')}</h2>
      <p class="mt-4 max-w-xs text-muted">{t('ach.desc')}</p>
    </div>

    <!-- Cards escalonadas: el primero arriba, el siguiente más abajo -->
    <div class="grid gap-10 sm:grid-cols-2">
      {achievements.map((a, i) => {
        const Tag = a.href ? 'a' : 'div';
        return (
          <Tag href={a.href || undefined} target={a.href ? '_blank' : undefined} rel={a.href ? 'noopener' : undefined}
               data-reveal="scale" style={`--d:${(i % 2) * 120}ms`} class={`group block ${i % 2 === 1 ? 'sm:mt-28' : ''}`}>
            <div class="flex items-start justify-between gap-4 border-t border-line pt-4 transition-colors duration-300 group-hover:border-accent-fg">
              <div>
                <h3 class="text-xl leading-snug font-bold">{pick(a.place, lang)}.<br /><span class="text-muted">{pick(a.event, lang)}</span></h3>
                <p class="mt-2 text-sm text-muted">{pick(a.desc, lang)}</p>
              </div>
              {a.href && <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent font-bold text-on-accent transition-transform duration-300 group-hover:rotate-45">↗</span>}
            </div>
            <div class="relative mt-4 aspect-[4/5] overflow-hidden rounded-xl bg-surface">
              {a.image && (
                <span class="absolute top-3 left-3 z-10 rounded-full px-3 pt-1 pb-0.5 font-display text-2xl leading-none tracking-wide text-on-accent shadow-lg"
                      style={`background:${a.color}`}>{a.rank}° {t('ach.place')}</span>
              )}
              {a.image
                ? <img src={a.image} alt={pick(a.event, lang)} class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease)] group-hover:scale-105" loading="lazy" />
                : (
                  <div class="flex h-full flex-col items-center justify-center transition-transform duration-700 ease-[var(--ease)] group-hover:scale-105"
                       style={`background: radial-gradient(90% 70% at 50% 40%, ${a.color}44, transparent 70%)`}>
                    <span class="font-display text-[10rem] leading-none" style={`color:${a.color}`}>{a.rank}°</span>
                    <span class="font-display text-2xl tracking-widest text-muted uppercase">{t('ach.place')} · {a.year}</span>
                  </div>
                )}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</section>
