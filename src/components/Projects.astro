---
import { projects } from '../data/portfolio';
import { getLang, useTranslations, pick } from '../i18n/ui';
import TechTag from './TechTag.astro';
import Rich from './Rich.astro';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section id="proyectos" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-24">
  <div data-reveal>
    <h2 class="font-display text-6xl uppercase">{t('projects.title')}</h2>
    <p class="mt-3 max-w-md text-muted">{t('projects.desc')}</p>
  </div>

  <div class="mt-16 space-y-28">
    {projects.map((p, i) => (
      <article class="grid items-center gap-10 md:grid-cols-2">
        <a href={p.links[0]?.href} target="_blank" rel="noopener" data-reveal="scale"
           class={`group block aspect-[3/2] rounded-xl ${p.image ? '' : 'overflow-hidden bg-surface'} ${i % 2 ? 'md:order-2' : ''}`}>
          {p.image
            ? <img src={p.image} alt={p.title} class="h-full w-full object-contain transition-transform duration-700 ease-[var(--ease)] group-hover:-translate-y-1.5 group-hover:scale-[1.03]" loading="lazy" />
            : (
              <div class="relative grid h-full place-items-center transition-transform duration-700 ease-[var(--ease)] group-hover:scale-105"
                   style={`background: radial-gradient(120% 90% at 30% 20%, ${p.color}55, transparent 60%), var(--surface)`}>
                <span class="font-display text-6xl uppercase sm:text-7xl" style={`color:${p.color}`}>{p.title}</span>
                <span class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs text-muted">{t('projects.image')}</span>
              </div>
            )}
        </a>

        <div data-reveal style="--d:120ms">
          <span class="text-sm font-bold text-accent-fg">{String(i + 1).padStart(2, '0')} · {pick(p.period, lang)}</span>
          <h3 class="mt-2 text-3xl font-bold">{p.title}</h3>
          <p class="mt-1 text-sm font-semibold text-muted">{pick(p.role, lang)}</p>
          <p class="mt-4 leading-relaxed text-muted"><Rich text={pick(p.desc, lang)} /></p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {p.tags.map((tag) => <TechTag name={tag} />)}
          </ul>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-5 text-sm font-bold tracking-wide uppercase">
            {p.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" class="group/l inline-flex items-center gap-2 text-accent-fg">
                {l.icon && <span class="icon-mask h-4 w-4" style={`--icon:url(${l.icon})`}></span>}
                {l.label}
                <span class="transition-transform duration-300 group-hover/l:translate-x-1 group-hover/l:-translate-y-1">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
