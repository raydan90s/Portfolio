---
import { tech } from '../data/tech';
interface Props { name: string; size?: 'sm' | 'md' }
const { name, size = 'md' } = Astro.props;
const t = tech[name];
const pad = size === 'sm' ? 'px-2.5 py-0.5' : 'px-3 py-1';
---
<li class={`inline-flex items-center gap-1.5 rounded-full border border-line text-xs text-muted ${pad}`}>
  {t && (t.mono
    ? <span class="icon-mask h-3.5 w-3.5 text-fg" style={`--icon:url(${t.icon})`} aria-hidden="true"></span>
    : <img src={t.icon} alt="" class="h-3.5 w-3.5 object-contain" loading="lazy" />)}
  {name}
</li>
